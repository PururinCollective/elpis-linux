# /etc/inittab -- BusyBox init
#
# <id>:<runlevels>:<action>:<process>; runlevels are ignored.

# Start the system: S05elpis-storage, the network, NTP (see /etc/init.d)
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys /run/elpis
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# The resolver, restarted whenever it exits
::respawn:/usr/libexec/elpis/run-elpis
# Confirms a freshly installed update once the resolver answers
::once:/usr/libexec/elpis/health

# The screen runs the setup guide and menu; the first serial port, when
# there is one, has a login
tty1::respawn:/usr/sbin/elpis-config --console
ttyS0::respawn:/usr/libexec/elpis/serial-getty ttyS0

::ctrlaltdel:/sbin/reboot

# Stop the system
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
